# Xana keeps its package cache inside the project so installs need no access
# outside the working directory. npm binds this correctly on a normal machine;
# an NPM_CONFIG_CACHE environment variable, if one is set, takes priority.
#
# Note: pnpm is not usable for this project. It hardcodes its store operation
# lock under %LOCALAPPDATA%\pnpm-store-operation-locks, which is outside the
# project and not configurable. Use npm.
cache=.npm-cache
fund=false
audit=false
